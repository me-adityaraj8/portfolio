---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { personal } from '../data/personal';
---
<Base title={`Off the clock, ${site.name}`} description={personal.intro} page="personal">
  <main class="personal-page" id="main" tabindex="-1">
    <p class="kicker">Off the clock</p>
    <h1>The other half</h1>
    <p class="lede">{personal.intro}</p>
    <div class="personal-grid">
      {personal.groups.map((g, i) => (
        <section class="personal-card" style={`--a:${g.tone[0]};--b:${g.tone[1]};--i:${i}`} aria-labelledby={`p-${i}`}>
          <h2 id={`p-${i}`}>{g.title}</h2>
          {g.body.map((p) => <p>{p}</p>)}
          {g.tags && <ul class="personal-tags">{g.tags.map((t) => <li>{t}</li>)}</ul>}
        </section>
      ))}
    </div>
    <p class="back"><a href="/">Back to the work</a></p>
  </main>
</Base>
