---
/**
 * Off the clock. An editorial page in numbered chapters, each laid out its own way:
 * a fanned poster wall, a record player, a pull quote, a feature
 * card, a photo spread. Text is mine (src/data/personal.ts); images are real.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { personal as p } from '../data/personal';
import media from '../data/personal-media.json';

type Glob = Record<string, { default: ImageMetadata }>;
const byName = (files: Glob) => Object.fromEntries(Object.entries(files).map(([f, m]) => [f.split('/').pop()!.replace(/\.[^.]+$/, ''), m.default]));
const posters = byName(import.meta.glob<{ default: ImageMetadata }>('../assets/posters/*.jpg', { eager: true }));
const covers = byName(import.meta.glob<{ default: ImageMetadata }>('../assets/covers/*.jpg', { eager: true }));
const photos = Object.entries(import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp,avif}', { eager: true }))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([file, m]) => {
    const raw = file.split('/').pop()!.replace(/\.[^.]+$/, '').replace(/^\d+[-_ ]*/, '').replace(/[-_]+/g, ' ');
    return { src: m.default, caption: raw.charAt(0).toUpperCase() + raw.slice(1) };
  });
const songs = media.songs.filter((s) => covers[s.id]);
const chapters = [
  ['movies', 'Movies & shows'], ['music', 'Music'], ['singing', 'Singing'], ['sports', 'Sports'], ['cooking', 'Cooking'],
  ['photography', 'Photography'], ['reading', 'Reading'], ['coding', 'Coding'], ['side-quests', 'Side quests'],
];
const no = (id: string) => String(chapters.findIndex(([c]) => c === id) + 1).padStart(2, '0');
const bars = Array.from({ length: 64 }, (_, i) => 0.18 + Math.abs(Math.sin(i * 0.47) * Math.cos(i * 0.19)) * 0.82);
---
<Base title={`Off the clock, ${site.name}`} description={p.intro} page="personal" image="/og/home.png">
  <main class="pp" id="main" tabindex="-1">

    <header class="pp-hero">
      <div class="pp-hero-copy">
        <p class="eyebrow">Off the clock</p>
        <h1>The other<br />half.</h1>
        <p class="pp-hero-intro">{p.intro}</p>
        <nav class="toc" aria-label="On this page">
          {chapters.map(([id, name], i) => <a href={`#${id}`}><span>{String(i + 1).padStart(2, '0')}</span>{name}</a>)}
        </nav>
      </div>
      {photos.length >= 3 && (
        <div class="pp-hero-stack" aria-hidden="true">
          {photos.slice(0, 3).map((ph, i) => (
            <figure style={`--i:${i}`}><Image src={ph.src} widths={[320, 640]} sizes="(max-width: 899px) 45vw, 300px" alt="" loading={i === 0 ? 'eager' : 'lazy'} /></figure>
          ))}
        </div>
      )}
    </header>

    <!-- 01 Movies: a shelf of posters; each opens a card. -->
    <section class="ch ch-movies" id="movies" aria-labelledby="h-movies" data-reveal-ch>
      <div class="ch-head">
        <span class="ch-no">{no('movies')}</span>
        <h2 id="h-movies">{p.movies.title}</h2>
        <div class="ch-body">{p.movies.body.map((t) => <p>{t}</p>)}</div>
      </div>
      <ul class="shelf" style={`--n:${p.movies.titles.length}`}>
        {p.movies.titles.map((t, i) => (
          <li style={`--i:${i};--fg:${t.tone[0]};--bg:${t.tone[1]}`}>
            <button type="button" class="poster" data-title={t.id} aria-haspopup="dialog" aria-label={`${t.title}, ${t.kind.toLowerCase()}, ${t.year}. Open details`}>
              {posters[t.id]
                ? <Image src={posters[t.id]} widths={[220]} alt="" loading="lazy" />
                : <span class="poster-type"><span class="poster-kind">{t.kind}</span><b>{t.title}</b><span class="poster-year">{t.year}</span></span>}
            </button>
          </li>
        ))}
      </ul>
      <p class="shelf-hint">Pick a poster for the details.</p>
    </section>

    <dialog class="sheet" id="title-sheet" aria-labelledby="sheet-title">
      <button type="button" class="sheet-close" data-close aria-label="Close">×</button>
      {p.movies.titles.map((t) => (
        <article class="sheet-card" data-card={t.id} hidden style={`--fg:${t.tone[0]};--bg:${t.tone[1]}`}>
          <div class="sheet-art">
            {posters[t.id]
              ? <Image src={posters[t.id]} widths={[220]} alt={`${t.title} poster`} loading="lazy" />
              : <span class="poster-type poster-type--big"><span class="poster-kind">{t.kind}</span><b>{t.title}</b><span class="poster-year">{t.year}</span></span>}
          </div>
          <div class="sheet-text">
            <p class="eyebrow">{t.kind} · {t.genre}</p>
            <h3 id={`sheet-${t.id}`}>{t.title}</h3>
            <p class="sheet-premise">{t.premise}</p>
            <dl>
              <div><dt>{t.kind === 'Film' ? 'Released' : 'Ran'}</dt><dd>{t.year}</dd></div>
              <div><dt>{t.kind === 'Film' ? 'Directed by' : 'Created by'}</dt><dd>{t.by}</dd></div>
              <div><dt>{t.kind === 'Film' ? 'Runtime' : 'Length'}</dt><dd>{t.length}</dd></div>
            </dl>
          </div>
        </article>
      ))}
      <h3 id="sheet-title" class="sr-only">Title details</h3>
    </dialog>

    <!-- 02 Music: words on the left, a record player on the right. -->
    <section class="ch ch-music" id="music" aria-labelledby="h-music" data-reveal-ch>
      <div class="ch-head">
        <span class="ch-no">{no('music')}</span>
        <div>
          <h2 id="h-music">{p.music.title}</h2>
          <div class="ch-body music-body">{p.music.body.map((t) => <p>{t}</p>)}</div>
        </div>
        <p class="genres" aria-label="Genres">
          {p.music.genres.map((g, i) => <span class:list={['genre', `g${i % 4}`]}>{g}</span>)}
        </p>
      </div>
      {songs.length > 0 && (
        <div class="deck" id="deck">
          <div class="turntable" aria-hidden="true">
            <div class="record" id="record">
              <Image class="record-label" id="record-label" src={covers[songs[0].id]} widths={[160]} alt="" />
            </div>
            <span class="tonearm"></span>
          </div>
          <div class="playlist">
            <p class="eyebrow playlist-head">A few favourites</p><p class="playlist-hint">Tap one to hear 30 seconds</p>
            <ol>
              {songs.map((s, i) => (
                <li>
                  <button type="button" class="track" data-src={s.preview} data-i={i} aria-pressed="false" aria-label={`Play a preview of ${s.title} by ${s.artist}`}>
                    <Image src={covers[s.id]} widths={[96]} alt="" loading="lazy" class="track-art" />
                    <span class="track-text"><b>{s.title}</b><span>{s.artist}</span></span>
                    <span class="track-state" aria-hidden="true"><i></i><i></i><i></i></span>
                  </button>
                </li>
              ))}
            </ol>
          </div>
          <div hidden id="covers">{songs.map((s) => <Image src={covers[s.id]} widths={[160]} alt="" data-cover={s.id} />)}</div>
        </div>
      )}
    </section>

    <!-- 03 Singing: one big line, and a waveform that sways. -->
    <section class="ch ch-singing" id="singing" aria-labelledby="h-singing" data-reveal-ch>
      <span class="ch-no">{no('singing')}</span>
      <h2 id="h-singing" class="kicker-title">{p.singing.title}</h2>
      <blockquote class="pull">“{p.singing.quote}”</blockquote>
      <div class="wave" aria-hidden="true">{bars.map((h, i) => <span style={`--h:${h.toFixed(2)};--i:${i}`}></span>)}</div>
      <div class="ch-body ch-body--center">{p.singing.body.map((t) => <p>{t}</p>)}</div>
    </section>

    <!-- 04 Sports. -->
    <section class="ch ch-sports" id="sports" aria-labelledby="h-sports" data-reveal-ch>
      <div class="ch-head">
        <span class="ch-no">{no('sports')}</span>
        <h2 id="h-sports">{p.sports.title}</h2>
        <div class="ch-body">{p.sports.body.map((t) => <p>{t}</p>)}</div>
      </div>
    </section>

    <!-- 05 Cooking: the favourite gets the spotlight. -->
    <section class="ch ch-cooking" id="cooking" aria-labelledby="h-cooking" data-reveal-ch>
      <div class="cook-copy">
        <span class="ch-no">{no('cooking')}</span>
        <h2 id="h-cooking">{p.cooking.title}</h2>
        <div class="ch-body">{p.cooking.body.map((t) => <p>{t}</p>)}</div>
        <p class="also">Also a regular in my kitchen: {p.cooking.also.join(', ').toLowerCase()}.</p>
      </div>
      <div class="fav">
        <span class="fav-badge">All-time favourite</span>
        <p class="fav-name">{p.cooking.favourite.name}</p>
        <p class="fav-note">{p.cooking.favourite.note}</p>
        <span class="steam" aria-hidden="true"><i></i><i></i><i></i></span>
      </div>
    </section>

    <!-- 06 Photography: an asymmetric spread; each photo opens large. -->
    {photos.length > 0 && (
      <section class="ch ch-photos" id="photography" aria-labelledby="h-photos" data-reveal-ch>
        <div class="ch-head">
          <span class="ch-no">{no('photography')}</span>
          <h2 id="h-photos">{p.photography.title}</h2>
          <div class="ch-body">{p.photography.body.map((t) => <p>{t}</p>)}</div>
        </div>
        <ul class="spread">
          {photos.map((ph, i) => (
            <li class={`sp sp${i % 5}`}>
              <button type="button" class="photo" data-photo={i} aria-haspopup="dialog" aria-label={`${ph.caption}. View larger`}>
                <Image src={ph.src} widths={[480, 900, 1400]} sizes="(max-width: 899px) 92vw, 45vw" alt={ph.caption} loading="lazy" />
              </button>
              <span class="photo-cap">{ph.caption}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <dialog class="lightbox" id="lightbox" aria-label="Photo">
      <button type="button" class="sheet-close" data-close aria-label="Close">×</button>
      {photos.map((ph, i) => (
        <figure data-shot={i} hidden><Image src={ph.src} widths={[900, 1600]} sizes="90vw" alt={ph.caption} loading="lazy" /><figcaption>{ph.caption} <span>{i + 1} / {photos.length}</span></figcaption></figure>
      ))}
      <div class="lb-nav"><button type="button" id="lb-prev" aria-label="Previous photo">←</button><button type="button" id="lb-next" aria-label="Next photo">→</button></div>
    </dialog>

    <!-- 07 Reading: a quote and a stack of plain spines. -->
    <section class="ch ch-reading" id="reading" aria-labelledby="h-reading" data-reveal-ch>
      <div class="spines" aria-hidden="true">{['#818cf8', '#38bdf8', '#a78bfa', '#2dd4bf', '#f472b6', '#fbbf24'].map((c, i) => <span style={`--c:${c};--i:${i}`}></span>)}</div>
      <div>
        <span class="ch-no">{no('reading')}</span>
        <h2 id="h-reading">{p.reading.title}</h2>
        <blockquote class="pull pull--small">{p.reading.quote}</blockquote>
        <div class="ch-body">{p.reading.body.map((t) => <p>{t}</p>)}</div>
      </div>
    </section>

    <!-- 08 Coding: the 3 AM log. -->
    <section class="ch ch-coding" id="coding" aria-labelledby="h-coding" data-reveal-ch>
      <div>
        <span class="ch-no">{no('coding')}</span>
        <h2 id="h-coding">{p.coding.title}</h2>
        <div class="ch-body">{p.coding.body.map((t) => <p>{t}</p>)}</div>
        <p class="also">The serious versions are <a href="/#work">over here</a>.</p>
      </div>
      <div class="term" aria-hidden="true">
        <div class="term-bar"><i></i><i></i><i></i><span>~/quick-project</span></div>
        <div class="term-body">
          <span class="t"><b>$</b> npm run quick-project</span>
          <span class="t"><em>21:04</em> this'll be a quick one</span>
          <span class="t"><em>23:30</em> websites, AI experiments, random tools</span>
          <span class="t"><em>02:10</em> new idea. different project.</span>
          <span class="t"><em>03:00</em> debugging something completely unrelated<span class="caret"></span></span>
        </div>
      </div>
    </section>

    <!-- 09 Side quests. -->
    <section class="ch ch-side" id="side-quests" aria-labelledby="h-side" data-reveal-ch>
      <span class="ch-no">{no('side-quests')}</span>
      <h2 id="h-side" class="kicker-title">{p.side.title}</h2>
      <p class="quests">{p.side.list.map((q) => <span>{q}</span>)}</p>
      <div class="ch-body ch-body--center">{p.side.body.map((t) => <p>{t}</p>)}</div>
    </section>

    <footer class="pp-end">
      <h2>Thanks for stopping by.</h2>
      <p>{p.outro}</p>
      <p class="pp-links"><a class="button" href="/#work">See the work</a><a href={`mailto:${site.email}`}>Say hi</a></p>
    </footer>
  </main>

  <script>
    import Lenis from 'lenis';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { SplitText } from 'gsap/SplitText';

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const $ = (s: string) => document.querySelector<HTMLElement>(s);

    // Drawings only move while their chapter is on screen.
    const io = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('on', e.isIntersecting)), { rootMargin: '0px 0px -15% 0px' });
    document.querySelectorAll('[data-reveal-ch]').forEach((c) => io.observe(c));

    // Same motion as the home page: smooth scrolling, titles that rise letter by letter,
    // and groups that arrive one item after another.
    const bar = document.getElementById('progress');
    const progress = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      if (bar) bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
    };
    addEventListener('scroll', progress, { passive: true });
    progress();

    let lenis: Lenis | null = null;
    if (!reduced) {
      gsap.registerPlugin(ScrollTrigger, SplitText);
      lenis = new Lenis({ lerp: 0.09, anchors: { offset: -72 } });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((t) => lenis!.raf(t * 1000));
      gsap.ticker.lagSmoothing(0);

      const EASE = 'expo.out';
      const name = SplitText.create('.pp-hero h1', { type: 'words' });
      gsap.timeline({ defaults: { ease: EASE } })
        .from('.pp-hero .eyebrow', { y: 16, opacity: 0, duration: 0.9 })
        .from(name.words, { yPercent: 45, opacity: 0, rotateX: -60, filter: 'blur(14px)', transformOrigin: '50% 100%', transformPerspective: 900, duration: 1.5, stagger: 0.14, onComplete: () => name.revert() }, '<0.1')
        .from(['.pp-hero-intro', '.toc a'], { y: 20, opacity: 0, duration: 1, stagger: 0.04 }, '<0.5')
        .from('.pp-hero-stack figure', { y: 80, opacity: 0, duration: 1.4, stagger: 0.12, clearProps: 'opacity' }, '<-0.6');

      // Chapter titles rise in, letter by letter.
      for (const el of document.querySelectorAll<HTMLElement>('.ch h2, .pp-end h2')) {
        const split = SplitText.create(el, { type: 'words,chars', mask: 'words' });
        gsap.from(split.chars, { yPercent: 110, duration: 1.1, ease: EASE, stagger: 0.018, scrollTrigger: { trigger: el, start: 'top 88%', once: true } });
      }
      // Everything else in a chapter fades up.
      gsap.utils.toArray<HTMLElement>('[data-reveal-ch]').forEach((ch) => {
        gsap.from(ch.querySelectorAll('.ch-no, .ch-body, .pull, .genres, .also'), { y: 30, opacity: 0, duration: 1, ease: EASE, stagger: 0.08, scrollTrigger: { trigger: ch, start: 'top 80%', once: true } });
      });
      // Groups that arrive one after another.
      const groups: Array<[string, gsap.TweenVars]> = [
        ['.shelf .poster', { y: 80, opacity: 0, rotate: 6 }],
        ['.track', { y: 18, opacity: 0 }],
        ['.spread .sp', { y: 70, opacity: 0, scale: 0.96 }],
        ['.spines span', { scaleY: 0, transformOrigin: 'bottom' }],
        ['.quests span', { y: 40, opacity: 0 }],
      ];
      for (const [sel, from] of groups) {
        const items = gsap.utils.toArray<HTMLElement>(sel);
        if (!items.length) continue;
        gsap.from(items, { ...from, duration: 1.1, ease: EASE, stagger: 0.06, clearProps: 'transform,opacity', scrollTrigger: { trigger: items[0], start: 'top 90%', once: true } });
      }
      for (const sel of ['.deck', '.fav', '.term', '.pp-end']) {
        gsap.from(sel, { y: 60, opacity: 0, scale: 0.97, duration: 1.2, ease: EASE, clearProps: 'transform,opacity', scrollTrigger: { trigger: sel, start: 'top 88%', once: true } });
      }
      // Photos drift gently against the scroll.
      gsap.utils.toArray<HTMLElement>('.photo img').forEach((img) => {
        img.style.scale = '1.14';
        gsap.fromTo(img, { yPercent: -6 }, { yPercent: 6, ease: 'none', scrollTrigger: { trigger: img, start: 'top bottom', end: 'bottom top', scrub: true } });
      });
    }

    // Dialogs: one sheet for titles, one lightbox for photos.
    const open = (d: HTMLDialogElement, from: HTMLElement) => {
      d.showModal();
      lenis?.stop();
      d.addEventListener('close', () => { lenis?.start(); from.focus({ preventScroll: true }); }, { once: true });
    };
    document.querySelectorAll<HTMLDialogElement>('dialog.sheet, dialog.lightbox').forEach((d) => {
      d.addEventListener('click', (e) => { if (e.target === d || (e.target as Element).closest('[data-close]')) d.close(); });
    });

    const sheet = $('#title-sheet') as HTMLDialogElement;
    document.querySelectorAll<HTMLButtonElement>('.poster').forEach((b) => b.addEventListener('click', () => {
      sheet.querySelectorAll<HTMLElement>('[data-card]').forEach((c) => { c.hidden = c.dataset.card !== b.dataset.title; });
      sheet.setAttribute('aria-labelledby', `sheet-${b.dataset.title}`);
      open(sheet, b);
    }));

    const lb = $('#lightbox') as HTMLDialogElement;
    const shots = [...lb.querySelectorAll<HTMLElement>('[data-shot]')];
    let at = 0;
    const show = (i: number) => { at = (i + shots.length) % shots.length; shots.forEach((s, k) => { s.hidden = k !== at; }); };
    document.querySelectorAll<HTMLButtonElement>('.photo').forEach((b) => b.addEventListener('click', () => { show(Number(b.dataset.photo)); open(lb, b); }));
    $('#lb-prev')?.addEventListener('click', () => show(at - 1));
    $('#lb-next')?.addEventListener('click', () => show(at + 1));
    lb.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(at - 1); if (e.key === 'ArrowRight') show(at + 1); });

    // The record player: one preview at a time; the label becomes the playing song's cover.
    const deck = $('#deck');
    if (deck) {
      const audio = new Audio();
      audio.preload = 'none';
      const tracks = [...deck.querySelectorAll<HTMLButtonElement>('.track')];
      const label = $('#record-label') as HTMLImageElement;
      const covers = [...deck.querySelectorAll<HTMLImageElement>('#covers img')];
      let current = -1;
      const setState = (i: number, playing: boolean) => {
        tracks.forEach((t, k) => t.setAttribute('aria-pressed', String(playing && k === i)));
        deck.classList.toggle('playing', playing);
      };
      tracks.forEach((t, i) => t.addEventListener('click', () => {
        if (current === i && !audio.paused) { audio.pause(); return; }
        current = i;
        audio.src = t.dataset.src!;
        const c = covers[i];
        if (c) { label.srcset = c.srcset; label.src = c.src; }
        audio.play().catch(() => setState(i, false));
      }));
      audio.addEventListener('play', () => setState(current, true));
      audio.addEventListener('pause', () => setState(current, false));
      audio.addEventListener('ended', () => setState(current, false));
    }
  </script>

  <style>
    .pp { max-width: 1240px; margin: 0 auto; padding: 140px 32px 96px; overflow-x: clip; }
    .eyebrow { margin: 0; font: 500 12px var(--cond); letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-3); }

    /* Hero: big type on the left, three of my photos fanned on the right. */
    .pp-hero { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 48px; align-items: center; min-height: min(78vh, 760px); }
    .pp-hero h1 { margin: 18px 0 0; font-size: clamp(56px, 9vw, 136px); line-height: 0.92; letter-spacing: -0.045em; text-transform: uppercase; }
    .pp-hero-intro { max-width: 460px; margin: 26px 0 0; font-size: 20px; line-height: 1.5; color: var(--ink-2); }
    .toc { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 6px 28px; margin-top: 40px; }
    .toc a { display: inline-flex; gap: 10px; align-items: baseline; padding: 4px 0; font-size: 15px; color: var(--ink-2); text-decoration: none; }
    .toc a span { font: 500 12px var(--cond); letter-spacing: 0.12em; color: var(--ink-4); }
    .toc a:hover { color: var(--ink); }
    .pp-hero-stack { position: relative; height: 560px; }
    .pp-hero-stack figure { position: absolute; margin: 0; width: 62%; aspect-ratio: 3 / 4; border-radius: 14px; overflow: hidden; box-shadow: 0 30px 70px rgb(0 0 0 / 0.5); border: 6px solid #f4f2ff; background: #f4f2ff;
      transition: rotate 0.7s var(--ease), translate 0.7s var(--ease); }
    .pp-hero-stack figure:nth-child(1) { left: 2%; top: 14%; rotate: -7deg; z-index: 1; }
    .pp-hero-stack figure:nth-child(2) { left: 36%; top: 0; rotate: 5deg; z-index: 2; }
    .pp-hero-stack figure:nth-child(3) { left: 20%; top: 34%; rotate: -1.5deg; z-index: 3; }
    .pp-hero-stack:hover figure:nth-child(1) { rotate: -11deg; translate: -18px 6px; }
    .pp-hero-stack:hover figure:nth-child(2) { rotate: 9deg; translate: 18px -6px; }
    .pp-hero-stack img { display: block; width: 100%; height: 100%; object-fit: cover; }

    /* Chapters. */
    .ch { padding: 120px 0 0; scroll-margin-top: 80px; }
    .ch-no { display: block; font: 600 15px var(--cond); letter-spacing: 0.14em; color: var(--ink-4); }
    .ch-no::after { content: ''; display: inline-block; width: 44px; height: 1px; margin-left: 12px; vertical-align: middle; background: var(--hair-2); }
    .ch h2 { margin: 14px 0 0; font-size: clamp(28px, 3.6vw, 46px); line-height: 1.08; letter-spacing: -0.025em; }
    .ch-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px 64px; align-items: start; margin-bottom: 48px; }
    .ch-head .ch-no { grid-column: 1 / -1; }
    .ch-head h2 { margin: 0; }
    .ch-body p { margin: 0 0 12px; font-size: 17px; line-height: 1.65; color: var(--ink-2); max-width: 60ch; }
    .ch-body--center { margin: 0 auto; text-align: center; }
    .ch-body--center p { margin-inline: auto; }
    .kicker-title { font-size: clamp(22px, 2.4vw, 30px) !important; color: var(--ink-2); }
    .also { margin: 18px 0 0; font-size: 15px; color: var(--ink-3); }
    .also a { color: var(--glow); }

    /* 01 Posters: a fanned wall sized to its row, so it never scrolls sideways. */
    .shelf { container-type: inline-size; display: flex; justify-content: center; margin: 0; padding: 30px 4% 10px; list-style: none; }
    .shelf li { --w: calc(100cqi / (var(--n) * 0.74 + 0.26)); flex: none; width: var(--w); max-width: 168px; margin-right: calc(var(--w) * -0.26); position: relative; z-index: calc(var(--n) - var(--i));
      transform: rotate(calc((var(--i) - (var(--n) - 1) / 2) * 3deg)) translateY(calc(abs(var(--i) - (var(--n) - 1) / 2) * 5px)); transform-origin: 50% 120%; transition: transform 0.5s var(--ease); }
    .shelf li:last-child { margin-right: 0; }
    .shelf li:hover, .shelf li:focus-within { z-index: 20; transform: rotate(0) translateY(-18px) scale(1.08); }
    .poster { position: relative; display: block; aspect-ratio: 2 / 3; width: 100%; border-radius: 10px; overflow: hidden; background: var(--bg); box-shadow: 0 18px 44px rgb(0 0 0 / 0.55); transition: box-shadow 0.5s var(--ease); }
    .poster img { display: block; width: 100%; height: 100%; object-fit: cover; }
    .poster::after { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12); background: linear-gradient(160deg, rgb(255 255 255 / 0.14), transparent 40%); pointer-events: none; }
    .poster:hover, .poster:focus-visible { box-shadow: 0 26px 60px rgb(0 0 0 / 0.65), 0 0 0 2px var(--fg); outline: none; }
    .shelf-hint { margin: 26px 0 0; text-align: center; font-size: 13px; color: var(--ink-4); }
    .poster-type { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: space-between; padding: 12px; text-align: left;
      background: radial-gradient(120% 80% at 50% 0%, color-mix(in srgb, var(--fg) 30%, var(--bg)), var(--bg) 70%); }
    .poster-type b { font: 700 clamp(11px, 1.8vw, 24px)/0.95 var(--display); letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg); }
    .poster-kind, .poster-year { font: 600 10px var(--cond); letter-spacing: 0.2em; text-transform: uppercase; color: color-mix(in srgb, var(--fg) 70%, transparent); }
    .poster-type--big b { font-size: 40px; }

    /* Title sheet and lightbox. */
    dialog { color: var(--ink); }
    dialog::backdrop { background: rgb(var(--bg-rgb) / 0.75); backdrop-filter: blur(10px); }
    .sheet { width: min(760px, 94vw); padding: 0; border: 1px solid var(--hair-2); border-radius: 22px; background: var(--bg-2); overflow: hidden; }
    .sheet[open] { animation: pop 0.45s var(--ease); }
    @keyframes pop { from { opacity: 0; transform: translateY(16px) scale(0.97); } }
    .sheet-card { display: grid; grid-template-columns: 240px minmax(0, 1fr); }
    .sheet-card[hidden] { display: none; }
    .sheet-art { position: relative; aspect-ratio: 2 / 3; background: var(--bg); }
    .sheet-art img { display: block; width: 100%; height: 100%; object-fit: cover; }
    .sheet-text { padding: 34px 34px 30px; background: radial-gradient(500px 260px at 100% 0%, color-mix(in srgb, var(--fg) 12%, transparent), transparent 70%); }
    .sheet-text h3 { margin: 10px 0 0; font-size: 34px; line-height: 1.05; letter-spacing: -0.02em; }
    .sheet-premise { margin: 16px 0 0; font-size: 17px; line-height: 1.6; color: var(--ink-2); }
    .sheet dl { display: grid; gap: 0; margin: 24px 0 0; border-top: 1px solid var(--hair); }
    .sheet dl div { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--hair); font-size: 14px; }
    .sheet dt { color: var(--ink-3); } .sheet dd { margin: 0; text-align: right; }
    .sheet-close { position: absolute; top: 12px; right: 12px; z-index: 2; width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--hair-2); background: rgb(var(--bg-rgb) / 0.7); font-size: 22px; line-height: 1; color: var(--ink); }
    .sheet-close:hover { border-color: var(--glow); }
    .lightbox { width: min(1100px, 94vw); max-height: 94vh; padding: 0; border: 0; background: transparent; overflow: visible; }
    .lightbox[open] { animation: pop 0.4s var(--ease); }
    .lightbox figure { margin: 0; text-align: center; }
    .lightbox figure[hidden] { display: none; }
    .lightbox img { max-width: 100%; max-height: 80vh; width: auto; height: auto; border-radius: 14px; box-shadow: 0 30px 80px rgb(0 0 0 / 0.6); }
    .lightbox figcaption { display: flex; justify-content: center; gap: 14px; margin-top: 14px; font-size: 15px; color: var(--ink-2); }
    .lightbox figcaption span { color: var(--ink-4); }
    .lb-nav { display: flex; justify-content: center; gap: 10px; margin-top: 12px; }
    .lb-nav button { width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--hair-2); font-size: 18px; }
    .lb-nav button:hover { border-color: var(--glow); }
    .lightbox .sheet-close { top: -6px; right: -6px; }

    /* 02 Music. */
    .music-body { margin-top: 20px; }
    .ch-music .ch-head { align-items: end; }
    .genres { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 18px; margin: 0; line-height: 1.1; }
    .genre { font-family: var(--display); letter-spacing: -0.02em; }
    .g0 { font-size: 30px; font-weight: 700; color: #f472b6; } .g1 { font-size: 22px; font-weight: 500; color: var(--ink-2); }
    .g2 { font-size: 34px; font-weight: 700; color: #c084fc; } .g3 { font-size: 20px; font-weight: 500; color: #38bdf8; }
    .genre:last-child { font: 400 17px var(--sans); color: var(--ink-3); letter-spacing: 0; }
    .deck { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 40px; align-items: center; padding: 32px; border: 1px solid var(--hair-2); border-radius: 22px;
      background: radial-gradient(400px 260px at 0% 0%, rgb(244 114 182 / 0.1), transparent 70%), var(--bg-2); }
    .turntable { position: relative; width: 220px; height: 220px; }
    .record { position: absolute; inset: 0; border-radius: 50%; display: grid; place-items: center;
      background: repeating-radial-gradient(circle, #101012 0 2px, #1c1c1f 2px 4px); box-shadow: 0 20px 50px rgb(0 0 0 / 0.55), inset 0 0 0 1px rgb(255 255 255 / 0.06); }
    .record::after { content: ''; position: absolute; inset: 0; border-radius: 50%; background: conic-gradient(from 20deg, transparent 0 18%, rgb(255 255 255 / 0.09) 24%, transparent 31% 68%, rgb(255 255 255 / 0.07) 74%, transparent 81%); }
    .record :global(.record-label) { position: relative; z-index: 1; width: 38%; height: 38%; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 3px #101012; }
    .deck.playing .record { animation: spin 3.2s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .tonearm { position: absolute; right: -6px; top: -4px; width: 8px; height: 110px; border-radius: 4px; background: linear-gradient(#d4d4d8, #71717a); transform-origin: 50% 6px; transform: rotate(-4deg); transition: transform 0.6s var(--ease); z-index: 2; }
    .tonearm::before { content: ''; position: absolute; left: -7px; top: -6px; width: 22px; height: 22px; border-radius: 50%; background: #3f3f46; border: 2px solid #a1a1aa; }
    .deck.playing .tonearm { transform: rotate(22deg); }
    .playlist-head { white-space: nowrap; }
    .playlist-hint { margin: 4px 0 12px; font-size: 13px; color: var(--ink-4); }
    .playlist ol { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 2px 12px; margin: 0; padding: 0; list-style: none; }
    .track { display: grid; grid-template-columns: 40px minmax(0, 1fr) 22px; gap: 12px; align-items: center; width: 100%; padding: 7px 8px; border-radius: 10px; text-align: left; transition: background 0.2s; }
    .track:hover, .track[aria-pressed='true'] { background: rgb(var(--ink-rgb) / 0.06); }
    .track :global(.track-art) { width: 40px; height: 40px; border-radius: 6px; object-fit: cover; }
    .track-text { display: grid; min-width: 0; }
    .track-text b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 15px; font-weight: 500; }
    .track-text span { font-size: 13px; color: var(--ink-3); }
    .track-state { display: inline-flex; align-items: end; gap: 2px; height: 14px; opacity: 0; }
    .track-state i { width: 3px; height: 100%; border-radius: 2px; background: #f472b6; transform-origin: bottom; }
    .track[aria-pressed='true'] .track-state { opacity: 1; }
    .track[aria-pressed='true'] .track-state i { animation: eq 0.8s ease-in-out infinite alternate; }
    .track-state i:nth-child(2) { animation-delay: -0.3s !important; } .track-state i:nth-child(3) { animation-delay: -0.55s !important; }
    @keyframes eq { from { transform: scaleY(0.25); } to { transform: scaleY(1); } }

    /* 03 Singing. */
    .ch-singing { text-align: center; }
    .ch-singing .ch-no::after, .ch-side .ch-no::after { display: none; }
    .pull { margin: 22px auto 0; max-width: 18ch; font: 700 clamp(36px, 5.6vw, 76px)/1.02 var(--display); letter-spacing: -0.035em;
      background: linear-gradient(90deg, #fb923c, #f472b6 45%, #c084fc); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .pull--small { max-width: none; margin: 22px 0; font-size: clamp(26px, 3vw, 38px); background: linear-gradient(90deg, #818cf8, #38bdf8); -webkit-background-clip: text; background-clip: text; }
    .wave { display: flex; align-items: center; gap: 3px; height: 80px; margin: 40px auto 36px; max-width: 760px; }
    .wave span { flex: 1; height: calc(var(--h) * 100%); border-radius: 3px; background: linear-gradient(180deg, #fb923c, #f472b6); opacity: 0.75; }
        .ch-singing.on .wave span { animation: sway 1.2s ease-in-out infinite alternate; animation-delay: calc(var(--i) * -61ms); }
    @keyframes sway { from { transform: scaleY(0.2); } to { transform: scaleY(1); } }

    /* 05 Cooking. */
    .ch-cooking { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); gap: 64px; align-items: center; }
    .cook-copy .ch-body { margin-top: 20px; }
    .fav { position: relative; padding: 46px 42px 42px; border-radius: 22px; overflow: hidden; color: #2a1608;
      background: radial-gradient(500px 300px at 100% 0%, rgb(251 146 60 / 0.55), transparent 60%), linear-gradient(160deg, #fde68a, #fbbf24 55%, #f59e0b); box-shadow: 0 30px 70px rgb(0 0 0 / 0.45); }
    .fav-badge { display: inline-block; padding: 6px 12px; border: 1.5px solid #7c2d12; border-radius: 999px; font: 700 11px var(--cond); letter-spacing: 0.2em; text-transform: uppercase; color: #7c2d12; }
    .fav-name { margin: 22px 0 0; font: 700 clamp(48px, 7vw, 96px)/0.9 var(--display); letter-spacing: -0.045em; text-transform: uppercase; color: #1c0f04; }
    .fav-note { margin: 18px 0 0; max-width: 30ch; font-size: 18px; line-height: 1.5; color: #4a2a0f; }
    .steam { position: absolute; right: 40px; top: 36px; display: flex; gap: 10px; }
    .steam i { width: 4px; height: 46px; border-radius: 4px; background: linear-gradient(transparent, rgb(124 45 18 / 0.35)); }
    .ch-cooking.on .steam i { animation: steam 2.4s ease-in-out infinite; }
    .steam i:nth-child(2) { animation-delay: -0.8s !important; } .steam i:nth-child(3) { animation-delay: -1.6s !important; }
    @keyframes steam { 0% { transform: translateY(10px) scaleY(0.6); opacity: 0; } 50% { opacity: 1; } 100% { transform: translateY(-16px) scaleY(1.1); opacity: 0; } }

    /* 06 Photo spread. */
    .spread { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-rows: 120px; gap: 16px; margin: 0; padding: 0; list-style: none; }
    .sp { position: relative; display: grid; grid-template-rows: minmax(0, 1fr) auto; gap: 8px; }
    .sp0 { grid-column: 1 / span 5; grid-row: 1 / span 5; }
    .sp1 { grid-column: 6 / span 4; grid-row: 1 / span 3; }
    .sp2 { grid-column: 10 / span 3; grid-row: 1 / span 4; }
    .sp3 { grid-column: 6 / span 3; grid-row: 4 / span 4; }
    .sp4 { grid-column: 9 / span 4; grid-row: 5 / span 3; }
    .photo { display: block; width: 100%; height: 100%; border-radius: 16px; overflow: hidden; background: var(--card); }
    .photo img { display: block; width: 100%; height: 100%; object-fit: cover; transition: scale 1s var(--ease); }
    .photo:hover img, .photo:focus-visible img { scale: 1.2 !important; }
    .photo-cap { font-size: 13px; color: var(--ink-3); }

    /* 07 Reading. */
    .ch-reading { display: grid; grid-template-columns: minmax(0, 0.6fr) minmax(0, 1fr); gap: 64px; align-items: center; }
    .spines { display: flex; align-items: end; justify-content: center; gap: 6px; height: 260px; padding: 0 20px; border-bottom: 2px solid var(--hair-2); }
    .spines span { width: 34px; height: calc(150px + var(--i) * 17px); border-radius: 4px 4px 0 0; background: linear-gradient(90deg, color-mix(in srgb, var(--c) 70%, black), var(--c)); box-shadow: inset 4px 0 0 rgb(0 0 0 / 0.2);
      transform-origin: bottom; transition: transform 0.6s var(--ease); }
    .spines span:nth-child(2n) { height: calc(200px - var(--i) * 9px); }
    .spines span:nth-child(5) { transform: rotate(8deg) translateX(6px); }
    .ch-reading:hover .spines span { transform: translateY(-6px); }
    .ch-reading:hover .spines span:nth-child(5) { transform: rotate(14deg) translate(10px, -4px); }

    /* 08 Coding. */
    .ch-coding { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; align-items: center; }
    .ch-coding .ch-body { margin-top: 20px; }
    .term { border: 1px solid rgb(255 255 255 / 0.08); border-radius: 14px; background: #0b0d12; overflow: hidden; box-shadow: 0 30px 70px rgb(0 0 0 / 0.45); }
    .term-bar { display: flex; align-items: center; gap: 6px; padding: 11px 14px; border-bottom: 1px solid rgb(255 255 255 / 0.06); }
    .term-bar i { width: 10px; height: 10px; border-radius: 50%; background: #ff5f57; }
    .term-bar i:nth-child(2) { background: #febc2e; } .term-bar i:nth-child(3) { background: #28c840; }
    .term-bar span { margin-left: 8px; font: 12px ui-monospace, Menlo, monospace; color: #8b949e; }
    .term-body { display: grid; gap: 4px; padding: 18px 18px 22px; font: 14px/1.7 ui-monospace, 'SF Mono', Menlo, monospace; color: #c9d1d9; }
    .term-body b { color: #7ee787; font-weight: 400; } .term-body em { font-style: normal; color: #a79bff; margin-right: 12px; }
    .t { opacity: 0; }
    .ch-coding.on .t { animation: show 0.01s forwards; }
    .ch-coding.on .t:nth-child(2) { animation-delay: 0.6s; } .ch-coding.on .t:nth-child(3) { animation-delay: 1.2s; }
    .ch-coding.on .t:nth-child(4) { animation-delay: 1.8s; } .ch-coding.on .t:nth-child(5) { animation-delay: 2.4s; }
    @keyframes show { to { opacity: 1; } }
    .caret { display: inline-block; width: 8px; height: 16px; margin-left: 4px; vertical-align: -3px; background: #c9d1d9; animation: blink 1s steps(1) infinite; }
    @keyframes blink { 50% { opacity: 0; } }

    /* 09 Side quests. */
    .ch-side { text-align: center; }
    .quests { display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: 6px 28px; margin: 22px 0 26px; }
    .quests span { font: 700 clamp(30px, 5.4vw, 72px)/1 var(--display); letter-spacing: -0.035em; text-transform: uppercase; }
    .quests span:nth-child(1) { color: #34d399; } .quests span:nth-child(2) { color: #38bdf8; } .quests span:nth-child(3) { color: #f472b6; }
    .quests .quests-more { font: 400 20px var(--sans); letter-spacing: 0; text-transform: none; color: var(--ink-3); }

    /* End. */
    .pp-end { margin-top: 140px; padding: 90px 32px; border: 1px solid var(--hair-2); border-radius: 26px; text-align: center;
      background: radial-gradient(circle at 1px 1px, rgb(var(--ink-rgb) / 0.12) 1px, transparent 0) 0 0 / 22px 22px, var(--bg-2); }
    .pp-end h2 { font-size: clamp(30px, 4.4vw, 56px); letter-spacing: -0.025em; }
    .pp-end p { margin: 16px auto 0; max-width: 520px; color: var(--ink-3); }
    .pp-links { display: flex; justify-content: center; align-items: center; gap: 22px; margin-top: 30px !important; }

    @media (max-width: 1099px) {
      .ch-cooking, .ch-coding, .ch-reading { grid-template-columns: 1fr; gap: 40px; }
      .spines { order: 2; height: 200px; }
    }
    @media (max-width: 899px) {
      .pp { padding: 104px 20px 72px; }
      .pp-hero { grid-template-columns: 1fr; min-height: 0; gap: 20px; }
      .pp-hero-stack { height: 360px; order: -1; margin-top: 8px; }
      .pp-hero-stack figure { width: 50%; }
      .toc { grid-template-columns: repeat(2, auto); }
      .ch { padding-top: 88px; }
      .ch-head { grid-template-columns: 1fr; margin-bottom: 32px; }
      .deck { grid-template-columns: 1fr; justify-items: center; padding: 22px 16px; }
      .turntable { width: 190px; height: 190px; }
      .playlist { width: 100%; }
      .shelf { padding-top: 16px; }
    }
    @media (max-width: 599px) {
      /* On phones the fan becomes a loose, tilted 3 x 3 pile instead of tiny slivers. */
      .shelf { flex-wrap: wrap; gap: 14px 10px; padding: 10px 2px 0; }
      .shelf li { --w: calc((100cqi - 24px) / 3); max-width: none; margin-right: 0; z-index: auto; transform: rotate(calc((var(--i) % 3 - 1) * 2.5deg)) translateY(calc((var(--i) % 2) * 6px)); }
      .fav { padding: 36px 26px 30px; }
      .spread { grid-template-columns: 1fr 1fr; grid-auto-rows: auto; }
      .sp { grid-column: auto !important; grid-row: auto !important; }
      .sp0 { grid-column: 1 / -1 !important; }
      .photo { aspect-ratio: 3 / 4; height: auto; }
      .sp0 .photo { aspect-ratio: 4 / 5; }
      .sheet-card { grid-template-columns: 1fr; }
      .sheet-art { aspect-ratio: auto; height: 240px; }
      .sheet-art img { object-fit: contain; background: var(--bg); }
      .sheet-text { padding: 24px 22px 24px; }
      .sheet-text h3 { font-size: 28px; }
    }
    @media (prefers-reduced-motion: reduce) { .t { opacity: 1; } }
  </style>
