---
import Icon from './Icon.astro';
import cp from '../data/cp.json';
import { site } from '../data/site';
import { cfRank } from '../lib/cp';
import { ringText } from '../lib/credentials';

const month = (d: string) => new Date(d).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const cf = cp.codeforces, lc = cp.leetcode;
const now = cfRank(cf.rating), peak = cfRank(cf.maxRating);
const merged = (repo: string) => site.openSource.find((r) => r.repo === repo)?.prs.filter((p) => p.state === 'merged') ?? [];
const fcc = merged('freeCodeCamp/freeCodeCamp');
const nano = merged('Nano-Collective/nanocoder');
const gh = 'https://github.com';
const RING = 389; // circumference of the r=62 ring the text runs round

const coins = [
  { name: 'Codeforces', icon: 'siCodeforces', color: now.color, big: String(cf.rating), small: now.title, sub: `Peak ${cf.maxRating}, ${peak.title}`, ring: `CODEFORCES · ${cp.handles.codeforces.toUpperCase()}`, href: `https://codeforces.com/profile/${cp.handles.codeforces}` },
  { name: 'LeetCode', icon: 'siLeetcode', color: '#ffa116', big: String(lc.rating), small: 'Rating', sub: `Top ${lc.top.toFixed(1)}% in contests`, ring: `LEETCODE · ${cp.handles.leetcode.toUpperCase()}`, href: `https://leetcode.com/u/${cp.handles.leetcode}` },
  ...(fcc.length ? [{ name: 'freeCodeCamp', icon: 'siFreecodecamp', color: '#a5b4fc', big: `#${fcc[0].n}`, small: 'Merged', sub: 'Contributor to the curriculum', ring: 'FREECODECAMP · CONTRIBUTOR', href: `${gh}/freeCodeCamp/freeCodeCamp/pull/${fcc[0].n}` }] : []),
  ...(nano.length ? [{ name: 'nanocoder', icon: '', color: '#c4b5fd', big: String(nano.length), small: nano.length === 1 ? 'PR merged' : 'PRs merged', sub: 'Contributor to the CLI', ring: 'NANO COLLECTIVE · CONTRIBUTOR', href: `${gh}/Nano-Collective/nanocoder/pulls?q=is%3Apr+author%3Ame-adityaraj8+is%3Amerged` }] : []),
];
const sealRing = (issuer: string) => ringText(`COURSE COMPLETED · ${issuer.toUpperCase()}`, 52);
---
<section class="section creds-sec" data-reveal id="credentials" aria-labelledby="creds-title">
  <h2 id="creds-title" class="section-title">Verified credentials &amp; badges</h2>
  <p class="creds-sum">Course certificates with their credential IDs, and standings you can check at the source.</p>

  <ul class="creds">
    {site.certificates.map((c, i) => (
      <li class="cred" style={`--i:${i}`}>
        <a class="cred-sheet" href={`/certificates/${c.slug}.pdf`} target="_blank" rel="noopener" aria-label={`Open the ${c.title} certificate (PDF)`}>
          <img src={`/certificates/${c.slug}.webp`} alt="" width="640" height="452" loading="lazy" decoding="async" />
          <span class="cred-shine" aria-hidden="true"></span>
        </a>
        <svg class="cred-seal" viewBox="0 0 160 160" aria-hidden="true">
          <defs><path id={`seal-${i}`} d="M80 80m-62 0a62 62 0 1 1 124 0a62 62 0 1 1-124 0" /></defs>
          <circle class="seal-disc" cx="80" cy="80" r="76" />
          <circle class="seal-edge" cx="80" cy="80" r="48" />
          <text class="seal-text"><textPath href={`#seal-${i}`} textLength={RING} lengthAdjust="spacing">{sealRing(c.issuer)}</textPath></text>
          <path class="seal-check" d="M60 81l13 13 27-29" pathLength="1" />
        </svg>
        <div class="cred-body">
          <span class="cred-issuer"><Icon name={c.icon} size={15} /> {c.issuer}</span>
          <h3 class="cred-title">{c.title}</h3>
          <dl class="cred-meta">
            <div><dt>Issued</dt><dd>{month(c.issued)}</dd></div>
            <div><dt>Credential ID</dt><dd>{c.id}</dd></div>
          </dl>
          <div class="cred-actions">
            {c.verify && (
              <a class="cred-verify" href={c.verify} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.4 1.8 3-.2.9 2.8 2.5 1.7-1 2.8 1 2.8-2.5 1.7-.9 2.8-3-.2L12 21.5l-2.4-1.8-3 .2-.9-2.8-2.5-1.7 1-2.8-1-2.8 2.5-1.7.9-2.8 3 .2z" /><path class="tick" d="M8.5 12.2l2.3 2.3 4.7-4.9" /></svg>
                Verify with the issuer <span aria-hidden="true">↗</span>
              </a>
            )}
            <a class="cred-pdf" href={`/certificates/${c.slug}.pdf`} target="_blank" rel="noopener">Certificate PDF <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </li>
    ))}
  </ul>

  <h3 class="coins-h">Badges</h3>
  <ul class="coins">
    {coins.map((b, i) => (
      <li style={`--c:${b.color}; --i:${i}`}>
        <a class="coin" href={b.href} target="_blank" rel="noopener">
          <span class="coin-disc">
            <svg class="coin-ring" viewBox="0 0 160 160" aria-hidden="true">
              <defs><path id={`coin-${i}`} d="M80 80m-62 0a62 62 0 1 1 124 0a62 62 0 1 1-124 0" /></defs>
              <circle class="coin-edge" cx="80" cy="80" r="77" />
              <circle class="coin-inner" cx="80" cy="80" r="50" />
              <text><textPath href={`#coin-${i}`} textLength={RING} lengthAdjust="spacing">{ringText(b.ring, 64)}</textPath></text>
            </svg>
            <span class="coin-face">
              {b.icon ? <Icon name={b.icon} size={16} /> : <svg class="icon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6l6 6-6 6M12 18h8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>}
              <b>{b.big}</b>
              <small>{b.small}</small>
            </span>
            <span class="coin-sheen" aria-hidden="true"></span>
          </span>
          <span class="coin-name">{b.name} <span aria-hidden="true">↗</span></span>
          <span class="coin-sub">{b.sub}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<script>
  const sec = document.getElementById('credentials');
  if (sec) {
    const io = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) { sec.classList.add('on'); io.disconnect(); }
    }, { threshold: 0.2 });
    io.observe(sec);
  }
</script>
