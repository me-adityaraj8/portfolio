---
import * as icons from 'simple-icons';

interface Props { name: string; size?: number; brand?: boolean }
const { name, size = 18, brand = false } = Astro.props;
// simple-icons dropped LinkedIn's mark, so these few are drawn here.
const own: Record<string, string> = {
  linkedin: 'M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z',
  mail: 'M2 5.5A2.5 2.5 0 0 1 4.5 3h15A2.5 2.5 0 0 1 22 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 18.5v-13Zm2.4.3 7.6 6.2 7.6-6.2H4.4Zm15.6 2.5-7.37 6.03a1 1 0 0 1-1.26 0L4 8.3v10.2c0 .28.22.5.5.5h15a.5.5 0 0 0 .5-.5V8.3Z',
  resume: 'M16.5 6.5v10a4.5 4.5 0 0 1-9 0V5a3 3 0 0 1 6 0v10.5a1.5 1.5 0 0 1-3 0V6.5h-1.5v9a3 3 0 0 0 6 0V5a4.5 4.5 0 0 0-9 0v11.5a6 6 0 0 0 12 0v-10h-1.5Z',
};
const si = (icons as Record<string, { path: string; hex: string } | undefined>)[name];
const path = own[name] ?? si?.path ?? '';
const fill = brand && si ? `#${si.hex}` : 'currentColor';
---
<svg class="icon" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" fill={fill}><path d={path} /></svg>
